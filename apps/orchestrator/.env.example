# apps/orchestrator: Mesa turns, managed and BYO brains, decision sweep (Cloud Run `chalito-orchestrator`).
# Example only: names and placeholders, never real values. Copy to apps/orchestrator/.env for a local run.
# [secret] = Secret Manager in deploy (secret id in parentheses), wired in infra/terraform/envs/dev/main.tf.
# Platform-set, don't define: PORT.

# --- Hub (Chalyb) ---
CHALYB_BASE_URL=https://www.chalyb.com
# [secret] (chalito-admin-token, Chalyb's; var.hub_admin_token_secret)
CHALITO_ADMIN_TOKEN=
# pre_margin (default) | post_margin. GO_LIVE 1.6a
HUB_RESERVE_BASIS=

# --- Database and auth ---
# [secret] (chalito-database-url)
DATABASE_URL=
# chalito_server only when the login holds it with SET (local, tests); unset in deploy
DATABASE_ROLE=
SUPABASE_URL=
# [secret] (chalito-supabase-secret-key) device token verification
SUPABASE_SECRET_KEY=

# --- BYO keys (KMS, Terraform output module.kms.byo_key_id) ---
BRAIN_KEYS_KMS_KEY=

# --- Managed brains (GO_LIVE 5.1) ---
# [secret] (chalito-anthropic-api-key) required
ANTHROPIC_API_KEY=
# [secret] (chalito-openai-api-key / chalito-xai-api-key) optional: without one, that provider's participants are skipped
OPENAI_API_KEY=
XAI_API_KEY=
# Gemini on Vertex via ADC (global endpoint); without it the low profile's companion uses Claude
GOOGLE_CLOUD_PROJECT=

# --- Web and the decision sweep ---
CHALITO_WEB_ORIGIN=https://chalito.chalyb.com
# both or neither: the sweep's OIDC signer and audience base (var.orchestrator_public_url)
SCHEDULER_SA_EMAIL=
ORCHESTRATOR_BASE_URL=

# --- Comped accounts ---
# [secret] (chalito-owner-uids)
OWNER_UIDS=
