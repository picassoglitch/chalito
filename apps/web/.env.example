# Hub Supabase project (nexo-ai): URL and the publishable (anon) key. Never the service role.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chalito api (Cloud Run): /sso/exchange and the rest of the control plane.
NEXT_PUBLIC_CHALITO_API_BASE=
# Chalito orchestrator (Cloud Run): Mesa, BYO keys, /v1/usage/daily for /uso. Falls back to the api
# base when unset. It must allow this site's origin (CORS: CHALITO_WEB_ORIGIN on the orchestrator).
NEXT_PUBLIC_CHALITO_ORCHESTRATOR_BASE=
# Chalyb hub: where users sign in and manage plans/credits.
NEXT_PUBLIC_HUB_URL=
