# apps/api: the control plane (Cloud Run `chalito`, deployed by Chalyb's engine module, GO_LIVE 4.3).
# Example only: names and placeholders, never real values. Copy to apps/api/.env for a local run.
# [secret] = Secret Manager in deploy (secret id in parentheses); never put the value in Terraform.
# Platform-set, don't define: PORT (8787 locally), K_SERVICE (Cloud Run; turns on Pub/Sub audit).

# --- Hub (Chalyb) ---
CHALYB_BASE_URL=https://www.chalyb.com
# [secret] (chalito-admin-token) engine bearer, shared with the hub
CHALITO_ADMIN_TOKEN=
# [secret] (chalito-sso-secret) verifies the hub's launch tokens
CHALITO_SSO_SECRET=
# pre_margin (default) | post_margin. GO_LIVE 1.6a; anything else stops the service at boot
HUB_RESERVE_BASIS=

# --- Database (nexo-ai, ADR 0017) ---
# [secret] (chalito-database-url, created by Chalyb's engine module) a login that holds chalito_server
DATABASE_URL=
# chalito_server only when the login holds it with SET (local, tests); unset in deploy
DATABASE_ROLE=
SUPABASE_URL=
# [secret] (supabase-secret-key, Chalyb's shared nexo-ai key; hub patch 06) server only: device users in Supabase Auth
SUPABASE_SECRET_KEY=
# supabase (the only backend since ADR 0017)
CHALITO_DATA_BACKEND=supabase

# --- Public URLs and origins ---
API_PUBLIC_URL=https://api.chalito.chalyb.com
CHALITO_WEB_ORIGIN=https://chalito.chalyb.com
# Desktop webview origins allowed by CORS (comma-separated; default covers macOS/Linux and Windows).
CHALITO_DESKTOP_ORIGINS=tauri://localhost,http://tauri.localhost,https://tauri.localhost
CHALITO_API_ISSUER=https://api.chalito.chalyb.com
CHALITO_MCP_RESOURCE=https://mcp.chalito.chalyb.com/mcp
CHALITO_WEBAUTHN_RP_ID=chalito.chalyb.com
CHALITO_WEBAUTHN_RP_NAME=Chalito
# comma-separated; defaults to https://<rp id>
CHALITO_WEBAUTHN_ORIGINS=
# proxies in front of Cloud Run: 0 behind its own front end, 1 behind an external load balancer (OPS §5)
TRUSTED_PROXIES=0

# --- Buckets and jobs (Chalito's Terraform outputs) ---
ACCOUNT_EXPORT_BUCKET=
AVATAR_BUCKET=
# keys the free-custom-companion markers (>= 32 chars; set once, don't rotate). Unset: derived from CHALITO_SSO_SECRET
AVATAR_FREE_MARKER_KEY=
RECORDS_BUCKET=
# both or neither: desktop releases (/descargar)
CHALITO_RELEASES_BUCKET=
CHALITO_RELEASES_SIGNER=

# Connect engine: the signed recipe catalog GET /v1/recipes/catalog serves (a SignedRecipeCatalog
# JSON file, signed offline with the production catalog key; docs/OPS.md). Unset: 404, and agents
# keep their built-in catalog. Locally: recipes/test-fixtures/catalog.dev.signed.json (dev key).
CHALITO_RECIPE_CATALOG_FILE=
# Cloud Scheduler's OIDC signer for /tasks/account-deletions
SCHEDULER_SA_EMAIL=
# Pub/Sub audit topic (default audit); PUBSUB_EMULATOR_HOST only for a local emulator
AUDIT_TOPIC=audit
PUBSUB_EMULATOR_HOST=

# --- MCP gateway ---
# [secret] (chalito-gateway-token) the same value on mcp-gateway
CHALITO_GATEWAY_TOKEN=

# --- Voice and phone ---
REALTIME_VOICE=marin
# [secret] (chalito-openai-api-key) optional: desktop push-to-talk is off without it
OPENAI_API_KEY=
# [secret] (chalito-voice-token-secret) required with OPENAI_API_KEY: 32 random bytes
VOICE_TOKEN_SECRET=
# [secret] (chalito-twilio-account-sid / -auth-token / -verify-service) phone verification
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# ms between recovery attempts (default 1 h)
RECOVERY_COOLDOWN_MS=

# --- Comped accounts ---
# [secret] (chalito-owner-uids) hub user ids, comma-separated: your own only
OWNER_UIDS=
