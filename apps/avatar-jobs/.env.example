# apps/avatar-jobs: one avatar upload per execution (Cloud Run job `chalito-avatar-jobs`, started by Eventarc + Workflow).
# Example only. In deploy the Workflow passes both per execution.

AVATAR_BUCKET=
# uploads/<owner>/<asset>/original
UPLOAD_PATH=

# --- Custom companions (src/creation.ts). Unset GEMINI_API_KEY: plain image cards only. ---
# Google AI Studio key (Secret Manager chalito-gemini-api-key in deploy)
GEMINI_API_KEY=
# chalito.avatar_creations + the usage outbox, as chalito_server (Secret Manager chalito-database-url)
DATABASE_URL=
# `chalito_server` when the login only holds it with SET (local, tests); unset in deploy
DATABASE_ROLE=
