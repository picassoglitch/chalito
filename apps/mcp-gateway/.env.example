# apps/mcp-gateway: the MCP endpoint for Claude and ChatGPT (Cloud Run `chalito-mcp-gateway`, mcp.chalito.chalyb.com).
# Example only: names and placeholders, never real values. Copy to apps/mcp-gateway/.env for a local run.
# [secret] = Secret Manager in deploy (secret id in parentheses). Platform-set, don't define: PORT.

CHALITO_API_URL=https://api.chalito.chalyb.com
CHALITO_API_ISSUER=https://api.chalito.chalyb.com
CHALITO_MCP_RESOURCE=https://mcp.chalito.chalyb.com/mcp
# A2A server (ADR 0022 §4): off unless both are set, here and on the other service. No default URL
# (its domain is owner decision #36), e.g. https://<gateway host>/a2a.
CHALITO_A2A_ENABLED=
CHALITO_A2A_RESOURCE=
# [secret] (chalito-gateway-token) the same value as the api's
CHALITO_GATEWAY_TOKEN=
# [secret] (chalito-gateway-database-url) a login that holds chalito_gateway
DATABASE_URL=
# chalito_gateway only when the login holds it with SET (local, tests); unset in deploy
DATABASE_ROLE=
