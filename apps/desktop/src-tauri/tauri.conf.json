{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chalito",
  "version": "0.0.0",
  "identifier": "com.chalyb.chalito",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "pet",
        "url": "pet.html",
        "title": "Chalito",
        "width": 220,
        "height": 260,
        "resizable": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "focus": false,
        "visibleOnAllWorkspaces": true
      },
      {
        "label": "panel",
        "url": "panel.html",
        "title": "Chalito",
        "width": 960,
        "height": 720,
        "minWidth": 480,
        "minHeight": 480,
        "visible": false,
        "center": true
      },
      {
        "label": "indicator",
        "url": "indicator.html",
        "title": "Chalito controla este equipo",
        "width": 520,
        "height": 60,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "visible": false,
        "visibleOnAllWorkspaces": true,
        "minimizable": false,
        "closable": false
      },
      {
        "label": "room",
        "url": "room.html",
        "title": "Chalito",
        "width": 1024,
        "height": 640,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; img-src 'self' data: blob: https://storage.googleapis.com; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost https://api.chalito.chalyb.com https://*.supabase.co wss://*.supabase.co http://127.0.0.1:* http://localhost:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "linux": {
      "deb": { "depends": ["libc6 (>= 2.39)"] }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["chalito"]
      }
    }
  }
}
