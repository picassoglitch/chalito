{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Pet, panel and room windows: show/hide each other, read geometry, events.",
  "windows": ["pet", "panel", "room"],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-unminimize"
  ]
}
