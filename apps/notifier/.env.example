# apps/notifier: escalation ladder, push, WhatsApp, SMS, calls, usage drain (Cloud Run `chalito-notifier`).
# Example only: names and placeholders, never real values. Copy to apps/notifier/.env for a local run.
# [secret] = Secret Manager in deploy (secret id in parentheses), wired in infra/terraform/envs/dev/main.tf.
# Platform-set, don't define: PORT.

# --- Hub (Chalyb) ---
CHALYB_BASE_URL=https://www.chalyb.com
# [secret] (chalito-admin-token, Chalyb's; var.hub_admin_token_secret)
CHALITO_ADMIN_TOKEN=
# pre_margin (default) | post_margin. GO_LIVE 1.6a
HUB_RESERVE_BASIS=

# --- Database ---
# [secret] (chalito-database-url)
DATABASE_URL=
# chalito_server only when the login holds it with SET (local, tests); unset in deploy
DATABASE_ROLE=

# --- URLs (Terraform: var.notifier_public_url, var.domain) ---
PUBLIC_BASE_URL=
APP_URL=https://chalito.chalyb.com

# --- GCP: Cloud Tasks, Pub/Sub, Scheduler (Terraform sets these) ---
GOOGLE_CLOUD_PROJECT=
TASKS_LOCATION=us-central1
TASKS_QUEUE=chalito-escalation
TASKS_SA_EMAIL=
PUBSUB_SA_EMAIL=
SCHEDULER_SA_EMAIL=

# --- Web Push (GO_LIVE 5.7) ---
VAPID_SUBJECT=https://chalito.chalyb.com
VAPID_PUBLIC_KEY=
# [secret] (chalito-vapid-private-key)
VAPID_PRIVATE_KEY=

# --- Twilio (GO_LIVE 5.4) ---
# [secret] (chalito-twilio-account-sid / -auth-token / -from-number)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- WhatsApp Cloud API (GO_LIVE 5.6) ---
# [secret] (chalito-meta-wa-phone-id / -access-token / -app-secret / -verify-token)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TOKEN=
META_APP_SECRET=
META_VERIFY_TOKEN=

# --- Voice on calls (GO_LIVE 5.2) ---
# [secret] (chalito-openai-api-key)
OPENAI_API_KEY=
# [secret] (chalito-openai-webhook-secret)
OPENAI_WEBHOOK_SECRET=
# [secret] (chalito-voice-ref-secret) 32 random bytes
VOICE_REF_SECRET=
# optional: sip:<proj>@sip.api.openai.com;transport=tls;secure=true (var.realtime_sip_uri)
REALTIME_SIP_URI=
REALTIME_VOICE=marin

# --- Notify outbox poke (GO_LIVE 2.4b) ---
# [secret] (chalito-notify-poke-secret) the same value as Vault chalito_notify_poke_secret
NOTIFY_POKE_SECRET=

# --- Comped accounts ---
# [secret] (chalito-owner-uids)
OWNER_UIDS=
