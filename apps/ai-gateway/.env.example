# apps/ai-gateway: "IA de Chalyb" for coding agents (Cloud Run `chalito-ai-gateway`, ai.chalito.chalyb.com; ADR 0030).
# Example only: names and placeholders, never real values. Copy to apps/ai-gateway/.env for a local run.
# [secret] = Secret Manager in deploy (secret id in parentheses). Platform-set, don't define: PORT.

# 1 serves managed coding requests; anything else answers 503 and revokes the token (the kill switch).
CODING_MANAGED_ENABLED=
CHALYB_BASE_URL=https://www.chalyb.com
# pre_margin (default) or post_margin, as on the api
HUB_RESERVE_BASIS=
# Proxies in front that append to X-Forwarded-For (an external load balancer: 1)
TRUSTED_PROXIES=
# chalito_ai_gateway only when the login holds it with SET (local, tests); unset in deploy
DATABASE_ROLE=
# Provider base URLs: the defaults are the providers' own; set only for a local fake
CODING_OPENAI_BASE_URL=
CODING_XAI_BASE_URL=
CODING_GEMINI_BASE_URL=
# [secret] (chalito-admin-token) the hub's engine bearer, the same value as the api's
CHALITO_ADMIN_TOKEN=
# [secret] (chalito-ai-gateway-database-url) a login that holds chalito_ai_gateway
DATABASE_URL=
# [secret] (chalito-coding-openai-key / chalito-coding-xai-key / chalito-coding-gemini-key) keys from
# provider projects used only for this; a missing one pauses that agent
CODING_OPENAI_API_KEY=
CODING_XAI_API_KEY=
CODING_GEMINI_API_KEY=
