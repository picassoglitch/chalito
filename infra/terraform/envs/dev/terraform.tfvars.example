# Copy to terraform.tfvars (git-ignored) and fill in (GO_LIVE 3.2). Every variable in variables.tf
# is listed; a test keeps it that way. No secret values go here: secrets are added to Secret
# Manager out of band (GO_LIVE 3.5).
#
# Apply order (GO_LIVE Phase 1 and 3):
#   1. Chalyb's Terraform with the `chalito` engine (hub patch 06): creates the `chalito` service
#      account and the chalito-admin-token, chalito-sso-secret and chalito-database-url secrets.
#   2. This apply, with api_service_account and hub_admin_token_secret set from step 1.
#   3. Chalyb again, with engine_extra_env / engine_extra_secret_env for chalito (its example).

# --- Project (Chalyb's GCP project: Chalito is a Chalyb engine, ADR 0016) ---
project_id     = "" # gcloud config get-value project
project_number = "" # gcloud projects describe <project_id> --format='value(projectNumber)'
region         = "us-central1"
domain         = "chalito.chalyb.com" # base host (ADR 0015): web on Vercel, api. and mcp. on Cloud Run

# --- Budget (module.budget, app=chalito resources) ---
billing_account    = "" # gcloud billing accounts list
alert_email        = "" # who gets the budget alerts
monthly_budget_usd = 0  # owner-set; the budget module alerts against it

# --- From Chalyb's apply (step 1) ---
api_service_account    = "" # chalito@<project_id>.iam.gserviceaccount.com (Chalyb output: engine service account)
hub_admin_token_secret = "chalito-admin-token"

# --- Public URLs ---
api_url                 = "https://api.chalito.chalyb.com"
notifier_public_url     = "" # empty on the first apply; the notifier's URL after the first deploy (GO_LIVE 4.6)
orchestrator_public_url = "" # same, for the orchestrator

# --- Supabase on nexo-ai (ADR 0017) and Web Push ---
supabase_url     = "https://uqcbziwdgbnzehipzjxp.supabase.co"
vapid_public_key = "" # npx web-push generate-vapid-keys (public half; GO_LIVE 5.7)

# --- Optional: OpenAI Realtime SIP for calls (GO_LIVE 5.2) ---
realtime_sip_uri = "" # sip:<proj>@sip.api.openai.com;transport=tls;secure=true
