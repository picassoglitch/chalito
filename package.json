{
  "name": "chalito",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "lint": "eslint . && pnpm lint:brand && pnpm lint:currency",
    "lint:brand": "tsx packages/brand/src/cli.ts",
    "lint:currency": "tsx packages/config/src/currency-cli.ts",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:emulator": "firebase emulators:exec --only firestore,auth --project demo-chalito 'pnpm -r --if-present run test:emulator'"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "turbo": "^2.11.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3",
    "firebase-tools": "^15.32.1"
  }
}
