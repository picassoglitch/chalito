{
  "name": "chalito",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "lint": "eslint . && pnpm lint:brand && pnpm lint:currency",
    "lint:brand": "tsx packages/brand/src/cli.ts",
    "lint:currency": "tsx packages/config/src/currency-cli.ts",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "render-showcase": "tsx scripts/render-showcase.ts",
    "check-showcase": "tsx scripts/render-showcase.ts --check"
  },
  "devDependencies": {
    "@chalito/avatar": "workspace:*",
    "@chalito/avatar-three": "workspace:*",
    "@chalito/config": "workspace:*",
    "@chalito/roster": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "pixelmatch": "^7.2.0",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5",
    "three": "0.186.1",
    "tsx": "^4.23.15",
    "turbo": "^2.11.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  },
  "pnpm": {
    "ignoredOptionalDependencies": [
      "@anthropic-ai/claude-agent-sdk-darwin-arm64",
      "@anthropic-ai/claude-agent-sdk-darwin-x64",
      "@anthropic-ai/claude-agent-sdk-linux-arm64",
      "@anthropic-ai/claude-agent-sdk-linux-arm64-musl",
      "@anthropic-ai/claude-agent-sdk-linux-x64",
      "@anthropic-ai/claude-agent-sdk-linux-x64-musl",
      "@anthropic-ai/claude-agent-sdk-win32-arm64",
      "@anthropic-ai/claude-agent-sdk-win32-x64"
    ]
  }
}
